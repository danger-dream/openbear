{
  "telegram": {
    "botToken": "123456:ABC-your-bot-token",
    "mode": "polling",
    "webhookHost": "",
    "webhookSecret": "",
    "webhookPort": 18960,
    "whitelistIds": [
      123456789
    ]
  },
  "models": {
    "providers": {
      "default": {
        "baseUrl": "https://api.example.com/v1",
        "apiKey": "replace-me",
        "protocol": "responses",
        "enabled": true,
        "models": [
          {
            "id": "your-model",
            "name": "your-model",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    },
    "primary": "default/your-model",
    "compressionModels": []
  },
  "memory": {
    "provider": "builtin",
    "identity": "openbear",
    "baseUrl": "",
    "accessKey": "",
    "timeoutS": 8
  },
  "agent": {
    "maxRunWallSeconds": 0,
    "noProgressRounds": 8,
    "compactRatio": 0.7,
    "keepRecentMessages": 100,
    "compactPrompt": "",
    "manualCompactMinPercent": 50,
    "compactMaxTokens": 32768,
    "compactMaxRetries": 1,
    "compactTimeoutS": 1800,
    "maxRetries": 10,
    "retryBackoffS": 0.5,
    "retryMaxDelayS": 32,
    "retryJitterRatio": 0.25,
    "emptyResponseRetryLimit": 1,
    "reasoningOnlyRetryLimit": 2,
    "llmConnectTimeoutS": 10,
    "llmFirstByteTimeoutS": 90,
    "llmIdleTimeoutS": 120,
    "llmTotalTimeoutS": 0
  },
  "tools": {
    "bashTimeoutS": 120,
    "bashMaxTimeoutS": 600,
    "bashOutputLimit": 200000,
    "bashSpoolMaxBytes": 67108864,
    "fileReadLimitLines": 2000,
    "fileReadOutputBytes": 100000,
    "fileReadMaxLineBytes": 64000,
    "fileStateMaxEntries": 512,
    "fileDiffMaxChars": 12000,
    "toolResultMaxChars": 32000,
    "skillsDir": "./skills",
    "disabledSkills": []
  },
  "storage": {
    "dbPath": "./data/openbear.db"
  },
  "mcp": {
    "enabled": false,
    "installDir": "./mcp-servers",
    "startupTimeoutS": 30,
    "toolCallTimeoutS": 120,
    "outputMaxChars": 20000,
    "inlineMaxChars": 8000,
    "defaultApproval": "ask",
    "toolNamePrefix": "mcp",
    "allowTools": [
      "*"
    ],
    "denyTools": [],
    "servers": {}
  },
  "rath": {
    "enabled": true,
    "statusUpdateIntervalS": 3,
    "maxConcurrentTasks": 5,
    "agentModelCallLimit": 200,
    "agentToolCallLimit": 500,
    "planControlCallLimit": 200,
    "agentPlanEnabled": true,
    "planMaxRevisionRounds": 5,
    "planMaxSteps": 30,
    "planMaxCriteriaPerStep": 10,
    "planMaxFinalOutputs": 20,
    "planDraftPrompt": "",
    "planRevisionPrompt": "",
    "planReviewPrompt": "",
    "planExecutionPrompt": "",
    "planContextRestorePrompt": "",
    "agentToolForegroundWaitS": 0
  },
  "web": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 18961,
    "customUrl": "",
    "sessionDays": 30,
    "loginRequestTtlSeconds": 300,
    "failedLoginCooldownMinutes": 10,
    "taskNotifications": {
      "enabled": true,
      "includeResult": true,
      "thresholdMinutes": 5,
      "events": [
        "task_started",
        "agent_started",
        "agent_finished",
        "retrying",
        "task_completed",
        "task_failed",
        "task_interrupted"
      ]
    }
  },
  "ui": {
    "showTurnStats": true
  },
  "media": {
    "downloadDir": "data/media/inbound",
    "maxMediaPerMessage": 10,
    "mediaGroupFlushMs": 1000
  },
  "logLevel": "INFO",
  "contextManagement": {
    "defaultStrategy": "sliding_window",
    "retainRatio": 0.15
  }
}
