#!/usr/bin/env bash
# OpenBear pre-commit：阻止敏感文件 / 凭证被误提交。
#
# 安装：git config core.hooksPath .githooks

set -euo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
RESET=$'\033[0m'

fail() {
    echo "${RED}[pre-commit] 拒绝提交：$*${RESET}" >&2
    exit 1
}

staged_list=$(mktemp "${TMPDIR:-/tmp}/openbear-pre-commit.XXXXXX")
blob=""
trap 'rm -f -- "$staged_list"; if [ -n "$blob" ]; then rm -f -- "$blob"; fi' EXIT
# NUL 保留任意文件名；取消改名识别，检查新目标但允许仅删除。
git diff --cached --name-only --no-renames --diff-filter=ACMT -z >"$staged_list"
if [ ! -s "$staged_list" ]; then
    exit 0
fi

while IFS= read -r -d '' f; do
    case "$f" in
        evals|evals/*)
            fail "$f 属于仅本机保留的 evals，不能提交"
            ;;
        openbear.json|openbear.json.tmp|.env|state.db|state.db-wal|state.db-shm)
            fail "$f 是敏感运行时文件，不能提交（样板请用 openbear.json.example）"
            ;;
        openbear.json.bak*|*.env|*.env.*|.env.*|*.db|*.db-wal|*.db-shm)
            fail "$f 匹配敏感文件通配规则"
            ;;
        data/*|logs/*|workspace/*|skills/*|mcp-servers/*|web/dist/*|web/node_modules/*|.venv/*|venv/*)
            fail "$f 属于本应 ignore 的运行时目录"
            ;;
    esac
done <"$staged_list"

patterns=(
    'sk-ant-api0[A-Za-z0-9_-]{20,}'
    'sk-ant-oat01-[A-Za-z0-9_-]{20,}'
    'sk-ant-ort01-[A-Za-z0-9_-]{20,}'
    'sk-proj-[A-Za-z0-9_-]{20,}'
    'sk-svcacct-[A-Za-z0-9_-]{20,}'
    'ccp-[0-9a-f]{32,}'
    'ghp_[A-Za-z0-9]{30,}'
    'gho_[A-Za-z0-9]{30,}'
    'github_pat_[A-Za-z0-9_]{30,}'
    'AIza[0-9A-Za-z_-]{30,}'
    '[0-9]{8,12}:AA[A-Za-z0-9_-]{30,}'
    '-----BEGIN OPENSSH PRIVATE KEY-----'
    '-----BEGIN RSA PRIVATE KEY-----'
    'eyJhbGciOi[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+'
)

# 读取暂存 blob 到私有临时文件；不把 NUL 放进 Bash 字符串，也不让
# grep -q/head 提前关闭管道，使 pipefail 把真实命中误判为失败。
blob=$(mktemp "${TMPDIR:-/tmp}/openbear-pre-commit.XXXXXX")
hits=0
while IFS= read -r -d '' f; do
    case "$f" in
        openbear.json.example|.githooks/pre-commit)
            continue
            ;;
    esac
    if ! git show ":$f" >"$blob" 2>/dev/null; then
        fail "无法读取 $f 的暂存内容，未完成凭证检查"
    fi
    # 上游公开探测资源仅按固定路径及完整摘要豁免，变过字节仍走凭证扫描。
    if [ "$f" = 'benchmark-package/ip.check.place/v0.1.0/main/ref/cookies.txt' ] &&
       [ "$(sha256sum "$blob" | cut -d ' ' -f 1)" = '8d05deb991fd5a094b4971b389bdd24c1c86c462dfb45dd3aa4befe77b34616f' ]; then
        continue
    fi
    # read 的空 delimiter 表示 NUL：找到 NUL 才成功，普通文本到 EOF 返回非零。
    if IFS= read -r -d '' binary_probe <"$blob"; then
        unset binary_probe
        continue
    fi
    unset binary_probe
    for pat in "${patterns[@]}"; do
        if LC_ALL=C grep -E -e "$pat" -q -- "$blob"; then
            # sed 读完整个流，不使用会提前退出、触发 SIGPIPE 的 head。
            matched=$(LC_ALL=C grep -E -e "$pat" -o -- "$blob" | sed -n '1,3p')
            echo "${RED}[pre-commit] 在 $f 中命中敏感模式：${RESET}" >&2
            printf '%s\n' "$matched" | sed 's/\(.\{12\}\).*\(.\{4\}\)$/  \1…\2/' >&2
            hits=$((hits + 1))
        fi
    done
done <"$staged_list"

if [ "$hits" -gt 0 ]; then
    fail "共命中 $hits 处潜在凭证。确认是误报才可用 git commit --no-verify。"
fi

echo "${GREEN}[pre-commit] ✓ 未发现敏感文件/凭证${RESET}" >&2
exit 0
